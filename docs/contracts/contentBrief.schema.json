{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contentBrief.schema.json",
  "title": "ContentBrief",
  "description": "L1 雷达 → L2 miaowazhongzi 的选题契约。由 radar scripts/generate_content.py 产出,GET /api/content/<date> 返回。",
  "type": "object",
  "required": ["date", "topics"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generator": {"type": "string"},
    "generated_at": {"type": "string"},
    "audience": {"type": "string"},
    "topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/topic"}}
  },
  "definitions": {
    "topic": {
      "type": "object",
      "required": ["id", "headline", "platforms"],
      "properties": {
        "id": {"type": "string", "description": "如 t-2026-10-10-01"},
        "headline": {"type": "string", "description": "面向受众的钩子式选题标题"},
        "angle": {"type": "string"},
        "audience": {"type": "string"},
        "corePoints": {"type": "array", "items": {"type": "string"}},
        "evidence": {
          "type": "array",
          "description": "必须带来源 URL;禁止编造数字;无直接信号时 url 写 (无直接信号)",
          "items": {
            "type": "object",
            "required": ["claim", "url"],
            "properties": {
              "claim": {"type": "string"},
              "source": {"type": "string"},
              "url": {"type": "string"}
            }
          }
        },
        "hook": {"type": "string"},
        "platforms": {
          "type": "array",
          "items": {"type": "string", "enum": ["xiaohongshu", "douyin", "wechat", "bilibili", "kuaishou", "shipinhao"]}
        },
        "tags": {"type": "array", "items": {"type": "string"}},
        "sourceRef": {"type": "string", "description": "对应雷达素材的标题/链接,便于人工追溯"},
        "compliance": {
          "type": "object",
          "properties": {
            "risky": {"type": "array", "items": {"type": "string"}},
            "notes": {"type": "string"}
          }
        }
      }
    }
  }
}
