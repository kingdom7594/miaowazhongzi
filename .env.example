# LLM 供应商（OpenAI 兼容；默认 DeepSeek）——生成模型
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 独立 judge 模型（L5 合规/质量评估用；必须 ≠ LLM_MODEL）
# 三个变量均可选，缺省分别回落 LLM_API_KEY / LLM_BASE_URL / deepseek-reasoner。
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=deepseek-reasoner

# 上游雷达（L1 选题源）
RADAR_BASE_URL=http://127.0.0.1:5080

# L3 视觉适配器（本地 skill-runner，独立进程；M3）
SKILL_RUNNER_BASE_URL=http://127.0.0.1:5090

# L3 出图产物根目录（app 只读预览用；须与 skill-runner 的 OUTPUT_ROOT 指向同一路径）。
# 缺省 <cwd>/skill-runner/data/renders（开发态仓根 / 部署态 /opt/miaowazhongzi 均成立）。
RENDER_OUTPUT_ROOT=

# 单次出图超时 ms（封面 ~150s / xhs 卡片 ~350s；默认 600000）
RENDER_TIMEOUT_MS=600000

# SQLite 数据文件
DB_PATH=./data/content-factory.db

# 知识库目录（默认 src/lib/knowledge）
# KNOWLEDGE_DIR=
