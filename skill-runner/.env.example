# skill-runner 配置（只走环境变量；由 ops-agent 部署时注入运行目录下的 .env）
# 本文件是模板，真实 .env 不入库（见 .gitignore）。

# 监听（仅回环，公网不暴露；miaowazhongzi 本机调用）
HOST=127.0.0.1
PORT=5090

# 图像 provider（中转站，异步任务式）
IMAGE_BASE_URL=https://www.aisplice.store/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_API_STYLE=task
IMAGE_POLL_INTERVAL_MS=2000
IMAGE_POLL_TIMEOUT_MS=300000

# 产物落地根目录（强制路径边界，output_dir 必须在其内）
OUTPUT_ROOT=./data/renders
# 保留天数（按日期分目录，手动清理）
RENDER_RETENTION_DAYS=30

# 成本闸（R10）
MAX_IMAGES_PER_RENDER=10
RENDER_CONCURRENCY=2

# 运行时
BUN_BIN=bun
PYTHON_BIN=python3

# 底层 skill（baoyu-image-gen / mondo）通过本地 shim 复用同一 provider。
# 指向本服务的 OpenAI 兼容 shim；API key 仅本地占位，真实 key 在上面 IMAGE_API_KEY。
SHIM_BASE_URL=http://127.0.0.1:5090/shim/v1

# mondo（可选，R9：mondo 暂用其自带 AI Gateway；先接 baoyu 主链路）
# AI_GATEWAY_API_KEY=
